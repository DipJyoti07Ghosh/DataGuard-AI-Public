# ==============================================
# DataGuard AI — Environment Configuration
# ==============================================

# Application
APP_NAME=DataGuard AI
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO

# Backend
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# PostgreSQL
# Format: postgresql+psycopg2://user:password@host:port/dbname
DATABASE_URL=

# File Storage
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=100

# LLM Provider Architecture (Phase 12A Automatic Fallback)
LLM_PROVIDER_ORDER=gemini,huggingface,ollama

# Hosted Gemini API (Primary Provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
GEMINI_TIMEOUT_SECONDS=30

# Hosted Hugging Face API (Secondary Fallback Provider)
HUGGINGFACE_API_TOKEN=
HUGGINGFACE_MODEL=Qwen/Qwen2.5-7B-Instruct
HUGGINGFACE_TIMEOUT_SECONDS=45

# Local Ollama (Tertiary Fallback Provider)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:1b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=60
OLLAMA_MAX_TOKENS=1024

# Authentication (JWT + Google OAuth)
JWT_SECRET_KEY=CHANGE_ME_IN_PRODUCTION_use_openssl_rand_hex_32
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=10080
GOOGLE_CLIENT_ID=

# RAG Knowledge & Grounding (Phase 11+)
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIMENSION=384
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50
RAG_TOP_K=8
RAG_MIN_SIMILARITY=0.35
ASSISTANT_DEFAULT_TOP_K=8

